# Dynamic (dynamic.xyz) — email/social/passkey login + embedded wallet
# Create an environment at https://app.dynamic.xyz and paste the ID here.
# If empty, the app falls back to injected-wallet-only demo mode.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# WalletConnect (legacy, no longer required after Dynamic migration)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-side only (never expose). Used by /api routes to write to the DB.
# The browser only reads public data with the anon key (RLS enabled).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Arc / Circle App Kit
# Network: "mainnet" (Arc, chain 5042) or "testnet" (Arc Testnet, chain 5042002).
# Default is testnet; production (Vercel) must set this to "mainnet".
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_KIT_KEY=your_circle_kit_key
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_ARC_REPUTATION_REGISTRY_ADDRESS=0
NEXT_PUBLIC_ARC_VALIDATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_ARC_JOB_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_ARC_ESCROW_VAULT_ADDRESS=
NEXT_PUBLIC_ARC_USDC_ADDRESS=
NEXT_PUBLIC_ARC_MOCK_MODE=true

# Reference addresses when NEXT_PUBLIC_ARC_NETWORK=mainnet (from docs.arc.io/arc/references/contract-addresses):
#   ERC-8004 IdentityRegistry:    0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
#   ERC-8004 ReputationRegistry:  0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
#   ERC-8004 ValidationRegistry:  0x8004Cc8439f36fd5F9F049D9fF86523Df6dAAB58
#   USDC (same on both networks): 0x3600000000000000000000000000000000000000
# ERC-8183 has no official mainnet deployment yet — ArcHive deploys its own copy
# (see contracts/erc8183/) and the address goes into NEXT_PUBLIC_ARC_JOB_MARKETPLACE_ADDRESS.

# Approval timelock: horas que o cliente tem para aprovar/reembolsar após a
# submissão da entrega antes do payout ficar elegível para auto-release. Padrão 72.
NEXT_PUBLIC_ARC_REVIEW_WINDOW_HOURS=72

# Fee recipient wallet (ArcHive platform fee)
NEXT_PUBLIC_FEE_RECIPIENT=0xYourFeeWallet

# App URL
NEXT_PUBLIC_APP_URL=https://archivearc.xyz

# ArcHive Metered Tools seller service
NEXT_PUBLIC_NANOPAYMENTS_SELLER_URL=http://localhost:4021
# Seller service (required at startup — see services/nanopayments-seller/.env.example)
SELLER_ADDRESS=0x0000000000000000000000000000000000000000
ALLOWED_ORIGIN=http://localhost:3000
ARC_NETWORK=testnet
MAX_PER_CALL_USD=0.01
MAX_TOTAL_PER_JOB_USD=25
JOB_CAP_FRACTION=0.03
